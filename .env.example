# =============================================================================
# Communication Response Module — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.

# REQUIRED: Your LLM provider API key
LLM_API_KEY=

# LLM Base URL (include the version path, e.g., /v1)
# Examples:
#   OpenAI:       https://api.openai.com/v1
#   Groq:         https://api.groq.com/openai/v1
#   Together:     https://api.together.xyz/v1
#   Gemini:       https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:       http://localhost:11434/v1
#   LM Studio:    http://localhost:1234/v1
LLM_BASE_URL=https://api.openai.com/v1

# Model ID for your provider
LLM_MODEL=gpt-4o

# Server port (Railway sets this automatically)
PORT=3000

# Optional: If frontend is hosted separately from the API
# VITE_API_BASE_URL=https://your-api.railway.app/api
